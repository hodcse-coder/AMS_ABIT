# Server-side only. Set your local database credentials in .env.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ABITDB
PORT=3000
# Optional bootstrap settings; used only when no Admin account exists.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-unique-password-at-least-12-characters
# Set COOKIE_SECURE=true when serving over HTTPS.
